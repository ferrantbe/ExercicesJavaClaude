<answer fraction="100" format="html"><text><![CDATA[oui, autant qu'il en faut]]></text><feedback format="html"><text></text></feedback></answer>
<answer fraction="0" format="html"><text><![CDATA[non, une seule]]></text><feedback format="html"><text></text></feedback></answer>
<answer fraction="0" format="html"><text><![CDATA[oui, mais seulement deux]]></text><feedback format="html"><text></text></feedback></answer>
